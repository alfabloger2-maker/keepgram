# @BotFather bergan token
BOT_TOKEN=1234567890:replace_with_bot_token

# Supabase: Project Settings -> Database -> Connection string -> URI.
# Render uchun Transaction pooler URI tavsiya qilinadi; [YOUR-PASSWORD] ni almashtiring.
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# Render servisining tashqi HTTPS manzili (oxirida / bo'lmasin)
APP_BASE_URL=https://keepgram.onrender.com

# 16-128 belgili tasodifiy qiymat; faqat A-Z a-z 0-9 _ -
WEBHOOK_SECRET=replace_with_a_long_random_webhook_secret

ADMIN_USERNAME=admin
# Admin panelga kirishda ishlatiladigan oddiy parol. Uni faqat Render Environment'da saqlang.
ADMIN_PASSWORD=replace_with_a_strong_admin_password
# Kamida 32 belgili tasodifiy session kaliti
SESSION_SECRET=replace_with_a_long_random_session_secret
# Telegram ichida /admin havolasini olishga ruxsat etilgan IDlar, vergul bilan
ADMIN_TELEGRAM_IDS=

APP_ENV=production
LOG_LEVEL=INFO
WEBHOOK_DROP_PENDING_UPDATES=false
